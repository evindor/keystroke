[Unit]
Description=Keystroke native audio (vLLM, Gemma 4 E2B INT4)
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
ExecStart=/usr/bin/bash %h/.local/share/keystroke/vllm/serve.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Nice=5
MemoryMax=14G
MemorySwapMax=0
OOMPolicy=stop

[Install]
WantedBy=graphical-session.target
