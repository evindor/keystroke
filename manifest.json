{
  "schemaVersion": 1,
  "id": "evindor.keystroke",
  "name": "Keystroke",
  "version": "0.2.0",
  "author": "Arseniy Zarechnev",
  "description": "An extension-first command palette that replaces the Omarchy menu",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Keystroke.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Keystroke",
    "description": "Opens the Keystroke command palette",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left"
  },
  "omarchy": {
    "clonedFrom": "omarchy.menu"
  },
  "license": "MIT"
}
