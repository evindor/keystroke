{
  "apiVersion": 1,
  "id": "flint.ai",
  "name": "AI & Web Search",
  "version": "0.1.0",
  "description": "Continue any query with your preferred assistant",
  "icon": "✳",
  "color": "#e79c85",
  "permissions": [
    "process",
    "clipboard.write",
    "open-url"
  ],
  "settings": [
    {
      "key": "provider",
      "type": "enum",
      "label": "Preferred AI provider",
      "default": "chatgpt",
      "options": [
        "chatgpt",
        "claude"
      ]
    },
    {
      "key": "mode",
      "type": "enum",
      "label": "Open conversations in",
      "default": "desktop",
      "options": [
        "desktop",
        "cli",
        "browser"
      ]
    }
  ]
}
