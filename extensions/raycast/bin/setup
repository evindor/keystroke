#!/bin/sh
# Install the pinned Node runtime the host needs. Idempotent.
# Writes only under ${XDG_DATA_HOME:-~/.local/share}/keystroke/raycast/runtime.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runtime=${XDG_DATA_HOME:-"$HOME/.local/share"}/keystroke/raycast/runtime
mkdir -p "$runtime"
cp "$here/../host/runtime-package.json" "$runtime/package.json"
cp "$here/../host/runtime-package-lock.json" "$runtime/package-lock.json"
cd "$runtime"
echo "Keystroke Raycast: installing the pinned Node runtime into $runtime"
npm ci --omit=dev --ignore-scripts --no-fund --no-audit
echo "Installed react and react-reconciler. Raycast extensions can run now."
