{
  "version": 1,
  "palette": {
    "density": "compact",
    "accent": "theme",
    "showPreview": true
  },
  "voice": {
    "backend": "voxtype",
    "audioEndpoint": "http://127.0.0.1:18782",
    "enabled": true,
    "secondTap": "voice",
    "keys": "SUPER + SPACE",
    "assist": true,
    "assistEndpoint": "http://127.0.0.1:18781"
  },
  "providers": {
    "omarchy": {
      "enabled": true,
      "confirmDestructive": true
    },
    "applications": {
      "enabled": true
    },
    "calculator": {
      "enabled": true,
      "precision": 12
    },
    "converter": {
      "enabled": true,
      "timezone": ""
    },
    "colors": {
      "enabled": true,
      "format": "hex"
    },
    "emoji": {
      "enabled": true
    },
    "clipboard": {
      "enabled": true,
      "limit": 100
    },
    "files": {
      "enabled": true,
      "files": true,
      "folders": true,
      "hidden": false,
      "limit": 10
    },
    "ai": {
      "enabled": true,
      "provider": "chatgpt",
      "mode": "desktop",
      "autoSend": false
    },
    "settings": {
      "enabled": true
    },
    "example.keystroke-hello": {
      "enabled": false,
      "greeting": "Hello"
    }
  }
}
