#!/usr/bin/env bash
# Developer/installer helper for Keystroke. Production loading is done by
# omarchy-shell; this script only wraps the Omarchy plugin CLI.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ID="$(jq -r .id "$ROOT/manifest.json")"
TARGET="$HOME/.config/omarchy/plugins/$ID"

usage() {
  cat <<USAGE
Usage: bin/keystroke <command>

  install     Copy this checkout (no symlinks, no tests/docs) to $TARGET, rescan and enable
  uninstall   Disable, remove the copy, restore the stock Omarchy menu
  enable      omarchy plugin enable $ID
  disable     omarchy plugin disable $ID (restores omarchy.menu)
  dictate     Open Dictate to Clipboard and start recording
  toggle      Toggle the palette (routes through omarchy.menu)
  open <q>    Open the palette with a query
  validate    omarchy plugin validate on this checkout
  matching [small|large]  Prepare the local matching engine and fetch the model (default: small)
  engine      Rebuild the static matching engine shipped in matching/bin (after editing matching/engine)
  test        Run QML, voice lifecycle, time-zone checks, and qmllint
USAGE
}

sync_copy() {
  mkdir -p "$(dirname "$TARGET")"
  local stage
  stage="$(mktemp -d "$(dirname "$TARGET")/.keystroke.XXXXXX")"
  # -L dereferences any symlink so the installed tree never contains one.
  rsync -aL --delete --exclude .git --exclude .claude --exclude .agents --exclude .codex --exclude tests --exclude docs --exclude assets --exclude examples --exclude experiments \
    --exclude '__pycache__' --exclude '*.pyc' --exclude matching/engine/target "$ROOT/" "$stage/"
  if [[ -e $TARGET ]]; then rm -rf "$TARGET"; fi
  mv "$stage" "$TARGET"
}

case "${1:-help}" in
  install)
    omarchy plugin validate "$ROOT"
    if ! python3 "$ROOT/helpers/matching-start.py" --model small --install-only; then
      echo "Smart Match setup did not finish. Ordinary search remains available; retry in Keystroke Settings." >&2
    fi
    sync_copy
    omarchy-shell shell rescanPlugins >/dev/null
    for _ in $(seq 1 40); do
      if omarchy-plugin-list --json | jq -e --arg id "$ID" 'any(.[]; .id == $id)' >/dev/null; then break; fi
      sleep 0.05
    done
    omarchy plugin enable "$ID"
    echo "Keystroke is now the Omarchy menu. Super+Space and every omarchy-menu caller route to it."
    ;;
  uninstall)
    omarchy plugin disable "$ID" || true
    rm -rf "$TARGET"
    omarchy-shell shell rescanPlugins >/dev/null
    echo "Removed $TARGET; the stock Omarchy menu is active again."
    ;;
  enable) omarchy plugin enable "$ID" ;;
  disable) omarchy plugin disable "$ID" ;;
  dictate) exec omarchy-shell shell summon omarchy.menu '{"scope":"dictation","title":"Dictate to Clipboard","dictate":true}' ;;
  toggle) exec omarchy-shell shell toggle omarchy.menu '{"menu":"root"}' ;;
  open)
    shift
    exec omarchy-shell shell summon omarchy.menu "$(jq -nc --arg q "${*:-}" '{query: $q}')"
    ;;
  validate) exec omarchy plugin validate "$ROOT" ;;
  matching) exec python3 "$ROOT/helpers/matching-start.py" --model "${2:-small}" --install-only ;;
  engine) exec "$ROOT/matching/engine/build-prebuilt.sh" ;;
  test)
    (cd "$ROOT/tests" && /usr/lib/qt6/bin/qmltestrunner -silent -input .)
    python3 "$ROOT/tests/applications_check.py"
    python3 "$ROOT/tests/files_check.py"
    python3 "$ROOT/tests/catalog_check.py"
    python3 "$ROOT/tests/matching_session_check.py"
    python3 "$ROOT/tests/palette_matching_check.py"
    python3 "$ROOT/tests/palette_shortcut_check.py"
    python3 "$ROOT/tests/palette_motion_check.py"
    uv run --with-requirements "$ROOT/matching/requirements.lock" python "$ROOT/tests/matching_worker_check.py"
    uv run --with-requirements "$ROOT/matching/requirements.lock" python "$ROOT/tests/matching_engine_check.py"
    python3 "$ROOT/tests/voice_session_check.py"
    python3 "$ROOT/tests/clipboard_transfer_check.py"
    python3 "$ROOT/tests/codex_session_check.py"
    python3 "$ROOT/tests/palette_dictation_check.py"
    python3 "$ROOT/tests/tz_helper_check.py"
    python3 "$ROOT/tests/extensions_check.py"
    python3 "$ROOT/tests/palette_extensions_check.py"
    python3 "$ROOT/tests/hotkeys_check.py"
    "$ROOT/tests/lint.sh"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
